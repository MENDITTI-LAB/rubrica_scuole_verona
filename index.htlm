6000L", "denominazione": "LICEO SCIENTIFICO STATALE \"ENRICO MEDI\"", "indirizzo": "VIA MAGENTA, 7/A", "cap": "37069", "comune": "VILLAFRANCA", "tipo": "PS", "telefono": "045 7902067", "fax": "045 6300817", "email": "vrps06000l@istruzione.it", "pec": "vrps06000l@pec.istruzione.it", "dirigente": "CATANZARO PAOLA", "reggenza": "", "dsga": "BERSANI MARIA"}, {"n": "101", "codice": "VRIC84700L", "denominazione": "ISTITUTO COMPRENSIVO", "indirizzo": "VIA F.LLI STEVANI, 24", "cap": "37059", "comune": "ZEVIO", "tipo": "IC", "telefono": "045 7850004", "fax": "045 6050909", "email": "vric84700l@istruzione.it", "pec": "vric84700l@pec.istruzione.it", "dirigente": "UBOLDI PAOLA", "reggenza": "", "dsga": "ZANELLA ROBERTA"}];
const list=document.getElementById('list'), q=document.getElementById('q'), count=document.getElementById('count'), empty=document.getElementById('empty');
const norm=s=>(s||'').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const esc=s=>(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function telhref(s){return 'tel:'+s.replace(/[^0-9+]/g,'')}
function card(r){
 const reg=r.reggenza?` <span class="chip">${esc(r.reggenza)}</span>`:'';
 return `<article class="card"><div class="name">${esc(r.denominazione)}</div><div class="place">${esc(r.comune)} · ${esc(r.codice)}</div>
 <div class="row"><span class="label">📍 Indirizzo:</span> ${esc(r.indirizzo)}, ${esc(r.cap)} ${esc(r.comune)}</div>
 <div class="row"><span class="label">☎ Telefono:</span> <a href="${telhref(r.telefono)}">${esc(r.telefono)}</a>${r.fax?` &nbsp; <span class="label">Fax:</span> ${esc(r.fax)}`:''}</div>
 <div class="row"><span class="label">✉ E-mail:</span> <a href="mailto:${esc(r.email)}">${esc(r.email)}</a></div>
 <div class="row"><span class="label">PEC:</span> <a href="mailto:${esc(r.pec)}">${esc(r.pec)}</a></div>
 <div class="row"><span class="label">Dirigente:</span> ${esc(r.dirigente)}${reg}</div>
 <div class="row"><span class="label">DSGA / Dir. amministrativo:</span> ${esc(r.dsga)}</div>
 <div class="chips"><span class="chip">${esc(r.tipo)}</span><span class="chip">n. ${esc(r.n)}</span></div></article>`
}
function render(){
 const terms=norm(q.value).trim().split(/\s+/).filter(Boolean);
 const out=DATA.filter(r=>{const hay=norm(Object.values(r).join(' ')); return terms.every(t=>hay.includes(t))});
 count.textContent=`${out.length} risultat${out.length===1?'o':'i'} su ${DATA.length} scuole`;
 list.innerHTML=out.map(card).join(''); empty.hidden=out.length>0;
}
q.addEventListener('input',render); render();
</script></body></html>
