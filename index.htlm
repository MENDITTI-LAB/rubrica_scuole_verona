<!doctype html>
<html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Rubrica Scuole Verona</title>
<style>
:root{--bg:#f5f7fb;--card:#fff;--text:#182230;--muted:#667085;--line:#d0d5dd;--accent:#155eef}
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--bg);color:var(--text)}
header{background:#173b6c;color:white;padding:22px 16px}header .wrap{max-width:1000px;margin:auto}h1{font-size:1.45rem;margin:0 0 5px}.sub{opacity:.9;font-size:.92rem}
main{max-width:1000px;margin:auto;padding:18px 14px 40px}.searchbox{position:sticky;top:0;background:var(--bg);padding:10px 0 12px;z-index:2}
input{width:100%;font-size:1.08rem;padding:15px 16px;border:1px solid var(--line);border-radius:14px;box-shadow:0 2px 8px #0000000d;outline:none}input:focus{border-color:var(--accent);box-shadow:0 0 0 3px #155eef22}
.meta{font-size:.88rem;color:var(--muted);margin:8px 3px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:12px}
.card{background:var(--card);border:1px solid #e4e7ec;border-radius:14px;padding:15px;box-shadow:0 1px 3px #0000000a}.name{font-weight:750;line-height:1.25;margin-bottom:7px}.place{font-weight:650;color:#344054;margin-bottom:8px}
.row{font-size:.92rem;margin:5px 0;overflow-wrap:anywhere}.label{color:var(--muted)}a{color:#175cd3;text-decoration:none}a:hover{text-decoration:underline}.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.chip{font-size:.78rem;background:#eef4ff;padding:4px 7px;border-radius:999px;color:#3538cd}
.empty{text-align:center;color:var(--muted);padding:40px 10px}footer{text-align:center;color:var(--muted);font-size:.78rem;margin-top:24px}mark{background:#fff3b0;padding:0}
</style></head><body>
<header><div class="wrap"><h1>Rubrica istituzioni scolastiche — Verona</h1><div class="sub">Anno scolastico 2024/2025 · dati aggiornati al 29/11/2024</div></div></header>
<main><div class="searchbox"><input id="q" type="search" autocomplete="off" placeholder="Cerca scuola, comune, codice, dirigente, DSGA, telefono, e-mail…" autofocus><div class="meta" id="count"></div></div><div class="grid" id="list"></div><div class="empty" id="empty" hidden>Nessun risultato.</div><footer>Ricerca locale nel browser: i dati sono incorporati nella pagina.</footer></main>
